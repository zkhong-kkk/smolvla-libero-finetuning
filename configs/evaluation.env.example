# Absolute path to a LeRobot pretrained_model directory.
MODEL_PATH="/mnt/disk2/hongzekun/outputs/your_run/checkpoints/last/pretrained_model"

# Output parent directory. The evaluation script creates a timestamped child.
OUTPUT_ROOT="$HOME/outputs"
RUN_NAME="stage2_smolvla_task0"

# LIBERO evaluation scope.
TASK_SUITE="libero_spatial"
TASK_IDS="[0]"
N_EPISODES=10
SEED=42

# Runtime settings used by the reported experiments.
CUDA_DEVICE=0
BATCH_SIZE=1
MAX_PARALLEL_TASKS=1
N_ACTION_STEPS=10
EMPTY_CAMERAS=1
USE_ASYNC_ENVS=false

# LIBERO emits image/image2; this SmolVLA checkpoint expects camera1/camera2.
RENAME_MAP='{"observation.images.image":"observation.images.camera1","observation.images.image2":"observation.images.camera2"}'
